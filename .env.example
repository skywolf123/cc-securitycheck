# cc-securitycheck 配置示例
# 用法：复制为 .env 后按需修改。留空/删除某行 = 用 proxy.py 内置默认值。
# 注意：真实 shell 环境变量优先于此文件（便于临时覆盖调试）。

# 监听地址。默认 127.0.0.1（仅本机）。
# 中转会转发你的 API key，不要改成 0.0.0.0 暴露到局域网/公网。
PROXY_HOST=127.0.0.1

# 监听端口。默认 8008。
PROXY_PORT=8008

# 上游 DeepSeek Anthropic 兼容端点。默认 https://api.deepseek.com/anthropic
UPSTREAM=https://api.deepseek.com/anthropic

# 仅改写分类器请求的 model 字段（如 deepseek-chat、glm-4-flash 等轻量模型）。
# 留空 = 透传 Claude Code 的 model。主请求永远透传，不受此项影响。
MODEL_OVERRIDE=

# 仅覆盖分类器请求的思考强度（thinking 字段）。留空 = 不覆盖。
# 取值（大小写不敏感）：
#   disabled / off / none —— 完全关闭思考（等价于 CLASSIFIER_NO_THINK=1）；
#   low / medium / high  —— 降档：{"type":"enabled","budget_tokens":1024/4096/16384}；
#   任意数字              —— 直接当 budget_tokens。
# 用途：有些模型不认 disabled、关不掉思考，用 low/medium 降档即可减少推理。
# 注意：本项非空时优先于 CLASSIFIER_NO_THINK。
THINKING_OVERRIDE=

# --- 分类器改写（默认都开；置 0/false/off 可单独关掉做对照）---

# 去掉分类器请求的 max_tokens：不限制输出长度，让模型推完再出结论，避免被截断。
CLASSIFIER_CAP_MAX_TOKENS=1

# 给分类器请求补 thinking:{"type":"disabled"}：能识别该字段的上游可跳过推理直接出结论。
# 上游若不认这个字段也无害（响应侧还会截取 verdict 前的推理）。
CLASSIFIER_NO_THINK=1

# 排障：把分类器请求/响应的**全文**原样打到日志（会刷屏，日常保持关闭）。两者独立：
#   CLASSIFIER_DUMP_REQ —— 打印 CC 分类器请求全文；
#   CLASSIFIER_DUMP_RAW —— 打印上游分类器响应全文（改写前、原样）。
CLASSIFIER_DUMP_REQ=0
CLASSIFIER_DUMP_RAW=0
